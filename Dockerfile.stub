# syntax=docker/dockerfile:1
FROM node:22-alpine AS build
WORKDIR /app
COPY apps/sender-stub/package.json apps/sender-stub/tsconfig.json apps/sender-stub/tsconfig.build.json ./
COPY tsconfig.base.json /tsconfig.base.json
COPY apps/sender-stub/src src
RUN sed -i 's#../../tsconfig.base.json#/tsconfig.base.json#' tsconfig.json \
 && npm install --no-audit --no-fund --no-package-lock typescript@5.9 @types/node@22 \
 && npx tsc -p tsconfig.build.json

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/dist ./dist
USER node
EXPOSE 5000
CMD ["node", "dist/main.js"]
