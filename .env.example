# Copy to .env:  cp .env.example .env
# Every variable of every app lives here. Values below work with `supabase start` (local demo keys,
# these are public defaults of the Supabase CLI and are NOT secrets). Replace them for any real deployment.

# ───────── Supabase (local, from `supabase start`) ─────────
# URL reachable from the host (tests, browser).
SUPABASE_URL=http://127.0.0.1:54321
# URL reachable from inside docker compose containers (host gateway).
SUPABASE_INTERNAL_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Server-side only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# Direct Postgres connection (host).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Direct Postgres connection from inside docker compose.
DATABASE_INTERNAL_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# ───────── API (apps/api) ─────────
API_PORT=4000
API_HOST=0.0.0.0
# Comma separated list of allowed browser origins.
API_CORS_ORIGINS=http://localhost:3000
# Only set true when api is really behind a trusted reverse proxy; otherwise X-Forwarded-For is ignored.
TRUST_PROXY=false
DB_POOL_MAX=10
# The API checks that the token's session still exists (sign-out deletes it). A positive answer is reused this many
# seconds, so a signed-out token stops working within that time. 0 = check the database on every request.
AUTH_SESSION_CACHE_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000
# Storage bucket for delivery photos (created by migrations).
PHOTO_BUCKET=delivery-photos
PHOTO_MAX_BYTES=5242880
SIGNED_URL_TTL_SECONDS=300
# Request hardening
BODY_LIMIT_BYTES=262144
REQUEST_TIMEOUT_MS=15000
HEADERS_TIMEOUT_MS=10000
KEEP_ALIVE_TIMEOUT_MS=5000
# Rate limiting (in-process token buckets, per IP and per user)
RATE_LIMIT_IP_PER_MINUTE=1200
RATE_LIMIT_USER_PER_MINUTE=1200
RATE_LIMIT_SENSITIVE_PER_MINUTE=120
RATE_LIMIT_TRACKING_PER_MINUTE=60
RATE_LIMIT_MAX_TRACKED_KEYS=50000
# Max simultaneous in-flight requests from a single IP (fair share).
MAX_INFLIGHT_PER_IP=64
MAX_INFLIGHT_GLOBAL=256
# Business limits (8 active deliveries, 45 min pickup, 5 wrong codes, 3 attempts) are enforced by the database and
# fixed in packages/shared; they are deliberately not settings.
BUSINESS_TIMEZONE=Europe/Kyiv

# ───────── Webhook notifications (api worker) ─────────
WEBHOOK_WORKER_ENABLED=true
WEBHOOK_POLL_INTERVAL_MS=1000
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_BACKOFF_BASE_SECONDS=30
WEBHOOK_BACKOFF_MAX_SECONDS=86400
# Hostnames allowed to resolve to private addresses (SSRF guard exception). The compose stub lives here.
WEBHOOK_ALLOWED_PRIVATE_HOSTS=sender-stub

# ───────── Sender stub (apps/sender-stub) ─────────
STUB_PORT=5000
STUB_HOST=0.0.0.0
# Secret the stub uses to verify signatures (must match the sender's webhook secret in the seed).
STUB_WEBHOOK_SECRET=whsec_demo_change_me
STUB_PUBLIC_URL=http://localhost:5000

# ───────── Web (apps/web) ─────────
WEB_PORT=3000
# Public values are baked into the browser bundle: only URLs and the anon key belong here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ───────── Tests ─────────
# Base URL of a running web app for Playwright.
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:4000
E2E_STUB_URL=http://localhost:5000
