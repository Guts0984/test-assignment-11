{
  "name": "@courier/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts"
  },
  "dependencies": {
    "@courier/db": "workspace:*",
    "@courier/shared": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@supabase/supabase-js": "^2.58.0",
    "drizzle-orm": "^0.44.0",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22",
    "fast-check": "^4.3.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
