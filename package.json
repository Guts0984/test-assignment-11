{
  "name": "courier-delivery",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r --filter '!@courier/db' --filter '!@courier/api' test && pnpm --filter @courier/api test:unit",
    "supabase": "supabase",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "pnpm --filter @courier/db test",
    "test:db": "pnpm --filter @courier/db test",
    "test:all": "pnpm test && pnpm test:integration",
    "test:integration": "pnpm --filter @courier/db test && pnpm --filter @courier/api test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "supabase": "^2.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
